# Integration-authored text remains normalized in Git.
*.md text eol=lf
*.py text eol=lf
*.csv text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.svg text eol=lf
*.pdf binary
*.gif binary

# Cadence executed snapshots are byte-evidence. Preserve their remote-run bytes
# so the published SHA-256 values do not depend on checkout EOL conversion.
/verification/asic_gpdk45_core/executed_snapshot/** -text
/verification/asic_gpdk45_core/executed_snapshot/README_KR.md text eol=lf

# Imported component snapshots override generic rules and preserve their native
# line endings. CRLF is therefore a valid end-of-line sequence in redacted
# public copies and must not be reported as trailing whitespace.
/components/** -text !eol whitespace=cr-at-eol

# Report vectors and frozen source exports retain their original byte hashes.
/figures/report_2026/** -text whitespace=cr-at-eol
/design/digital/rtl/rhythm3_duration_v3/** -text whitespace=cr-at-eol
/design/digital/rtl/rhythm3_duration_v3/README.md text eol=lf
/models/rhythm3_duration/** -text whitespace=cr-at-eol
/models/rhythm3_duration/README_KR.md text eol=lf
/datasets/rhythm3_duration_v3/** -text whitespace=cr-at-eol
/datasets/rhythm3_duration_v3/README_KR.md text eol=lf
/datasets/DATASET_LICENSES.md -text
/verification/low_power_gals_research/models/TLATNTSCAX4_functional.v -text
